{
    "name": "@software-hardware-integration-lab/objectid-converter",
    "version": "2.2.0",
    "description": "Converts Microsoft Object IDs to and from SIDs.",
    "main": "bin/src/index.js",
    "type": "module",
    "scripts": {
        "build:Dev": "tsc",
        "prebuild:Prod": "tsc -p prod.tsconfig.json --emitDeclarationOnly false",
        "build:Prod": "tsc -p prod.tsconfig.json --removeComments false",
        "test:Unit": "node --experimental-test-module-mocks --test bin/test/unit/**/*.test.js",
        "lint": "eslint --max-warnings 0",
        "prepare": "ts-patch install"
    },
    "keywords": [
        "Object ID",
        "Azure",
        "Entra",
        "Entra ID",
        "Windows",
        "Cloud",
        "UUID",
        "Converter",
        "Library",
        "Easy",
        "Minimal",
        "Security Identifier",
        "SID",
        "GUID"
    ],
    "packageManager": "npm@12.0.1",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.18.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "onFail": "error"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Software-Hardware-Integration-Lab/ObjectID-Converter.git"
    },
    "bugs": {
        "url": "https://github.com/Software-Hardware-Integration-Lab/ObjectID-Converter/issues"
    },
    "author": "Elliot Huffman <elliot_huffman@shi.com>",
    "license": "MIT",
    "dependencies": {
        "typia": "~12.1.1",
        "uuid": "~14.0.1"
    },
    "devDependencies": {
        "@software-hardware-integration-lab/development-utilities": "~3.0.0",
        "@types/node": "~26.1.2",
        "ts-patch": "~4.0.1",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "is-core-module": "npm:@socketregistry/is-core-module@^1",
        "is-interactive": "npm:@socketregistry/is-interactive@^1",
        "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@^1",
        "path-parse": "npm:@socketregistry/path-parse@^1",
        "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
        "safer-buffer": "npm:@socketregistry/safer-buffer@^1"
    },
    "resolutions": {
        "is-core-module": "npm:@socketregistry/is-core-module@^1",
        "is-interactive": "npm:@socketregistry/is-interactive@^1",
        "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@^1",
        "path-parse": "npm:@socketregistry/path-parse@^1",
        "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
        "safer-buffer": "npm:@socketregistry/safer-buffer@^1"
    }
}
